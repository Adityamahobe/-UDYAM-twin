# Copy to .env (git-ignored) and fill in. run.sh loads .env into the server process only;
# nothing here is ever sent to the browser, returned by the API, or committed.

# --- Advisor chatbot (POST /api/chat) ---
# Which model answers: auto (default) = Gemini if configured, else a local Ollama model, else offline.
# UDYAM_LLM_PROVIDER=auto

# Google Gemini API (Google Gen AI SDK). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Required: a model ID your key can use. List them with:  python -m tools.gemini_models
GEMINI_MODEL=
# GEMINI_TIMEOUT_S=60
# GEMINI_MAX_RETRIES=2
# GEMINI_MAX_OUTPUT_TOKENS=8192

# Optional: a local model with Ollama (works without internet). `ollama pull qwen2.5:7b` first.
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434/v1
# UDYAM_LLM_TIMEOUT_S=60

UDYAM_CHAT_MAX_TOOL_ROUNDS=6
# 1: answer offline from the twin's tools when the chat model is unavailable (the response says why); 0: HTTP errors
UDYAM_CHAT_OFFLINE_FALLBACK=1

# Approving an Advisor proposal (derate / work order). If set, the operator must enter this token;
# if unset, only a browser on the server machine itself can approve.
# UDYAM_OPERATOR_TOKEN=

# --- Server ---
# PORT=8000
# UDYAM_AUTO_DEMO=1
# UDYAM_MQTT_HOST=localhost
